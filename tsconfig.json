{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["./*"],
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main/updater": ["./.hutch/devkit/api/sdks/main/entries/updater.ts"],
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
    },
    "types": ["bun"]
  },
  "include": [
    "src",
    "components",
    "lib",
    "vite.config.ts",
    "electrobun.config.ts",
    "hutch.config.ts"
  ],
  "exclude": ["node_modules", "dist", "build", "artifacts", ".hutch"]
}
