{
  "name": "term",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/hutch.mjs run dev:hmr",
    "dev:hmr": "bun scripts/hutch.mjs run dev:hmr",
    "dev:watch": "bun scripts/hutch.mjs run dev",
    "dev:bundled": "bun scripts/hutch.mjs run start",
    "prepare:desktop": "bun scripts/hutch.mjs electrobun prepare",
    "start": "bun scripts/hutch.mjs run start",
    "build": "bun scripts/hutch.mjs run build",
    "build:canary": "bun scripts/hutch.mjs run build:canary",
    "test": "bun test ./tests",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "type-check": "tsc --noEmit",
    "dev:web": "concurrently -k \"bun src/bun/web.ts\" \"bunx vite\"",
    "dev:marketing": "bunx --bun vite marketing --config marketing/vite.config.ts",
    "build:marketing": "bunx --bun vite build marketing --config marketing/vite.config.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@pierre/diffs": "^1.2.12",
    "@pierre/trees": "^1.0.0-beta.5",
    "@wterm/dom": "^0.5.9",
    "@wterm/ghostty": "^0.5.9",
    "@wterm/react": "^0.5.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.8.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.2.2",
    "@types/bun": "latest",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.0.0",
    "concurrently": "^10.0.3",
    "oxfmt": "^0.60.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.9",
    "tailwindcss": "^4.2.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "^7.0.0"
  }
}
